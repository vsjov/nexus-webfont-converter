{
  "name": "nexus-webfont-converter",
  "version": "1.1.0",
  "description": "Converter for desktop font files (TTF, OTF) to web font formats (WOFF, WOFF2)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "wfc": "./dist/cli/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "git clean -dfx && npm ci && npm run test && npm run build",
    "prepublishOnly": "npm run build-all",
    "build-all": "npm run lint && npm run test && npm run test:scripts && npm run test:tools && npm run build && npm run build:tools && npm run pack:check",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "test": "vitest run src",
    "test:scripts": "vitest run scripts --reporter=dot",
    "test:tools": "vitest run tools/release-validator/src --reporter=dot",
    "test:watch": "vitest --watch",
    "build": "rimraf dist && tsc --build --clean && tsc -p tsconfig.lib.json && node -e \"require('fs').chmodSync('dist/cli/cli.js',0o755)\"",
    "build:tools": "npm --prefix tools/release-validator run build",
    "build:watch": "tsc --build --clean && tsc -p tsconfig.lib.json --watch",
    "pack:check": "npm pack --dry-run",
    "validate:release-tag": "node ./tools/release-validator/dist/cli.js",
    "version-update": "node ./scripts/package-version-update.js",
    "convert": "gulp --silent --gulpfile dist/gulpfile.js",
    "compile-css": "gulp compileCss --silent --gulpfile dist/gulpfile.js",
    "recompile-html": "gulp recompileHtml --silent --gulpfile dist/gulpfile.js",
    "remove-unused": "gulp removeUnused --silent --gulpfile dist/gulpfile.js",
    "sync": "gulp sync --silent --gulpfile dist/gulpfile.js",
    "update-npm": "ncu -t minor --deep -u --rejectVersion \"/^\\d+\\.\\d+\\.\\d+$/\" --cooldown 14"
  },
  "dependencies": {
    "@types/cli-progress": "^3.11.6",
    "browserslist": "^4.28.5",
    "cli-progress": "^3.12.0",
    "del": "^8.0.1",
    "gulp": "^5.0.1",
    "gulp-lightningcss": "^1.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sass": "^6.0.1",
    "picocolors": "^1.1.1",
    "sass": "^1.101.0",
    "tslib": "^2.8.1",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/gulp": "^4.0.18",
    "@types/gulp-rename": "^2.0.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25",
    "app-root-path": "^3.1.0",
    "eslint-plugin-jsdoc": "^63.0.12",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^22.2.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vsjov/nexus-webfont-converter.git"
  },
  "homepage": "https://github.com/vsjov/nexus-webfont-converter#readme",
  "bugs": {
    "url": "https://github.com/vsjov/nexus-webfont-converter/issues"
  },
  "keywords": [
    "webfont",
    "woff",
    "woff2",
    "ttf",
    "otf",
    "font-converter",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Vladimir Jovanović <vladimir@bitersen.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
